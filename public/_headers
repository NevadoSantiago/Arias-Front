# Security headers for the static site (Cloudflare Workers Static Assets).
# Applies to every asset, including the SPA fallback index.html. No caching
# headers are set here on purpose: index.html revalidation stays as is.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  # The app uses none of these browser features (checked against src/).
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  # REPORT-ONLY on purpose: violations show in the browser console but nothing
  # is blocked, so Google login and Mercado Pago cannot break. Once production
  # is clean, rename it to Content-Security-Policy to enforce it.
  # Sources:
  #   script-src   self + Google Identity Services client (accounts.google.com/gsi/client)
  #   style-src    self + 'unsafe-inline' (Radix/sonner inject <style>, inline style attrs)
  #                + Google Fonts CSS (fonts.googleapis.com) + GIS button CSS (accounts.google.com/gsi/style)
  #   font-src     Google Fonts files (fonts.gstatic.com)
  #   img-src      self, data:/blob: (image cropper previews), R2 public bucket (*.r2.dev or a custom
  #                *.ariasbodegon.com domain; R2_PUBLIC_URL is set in the backend env, not in this repo)
  #   connect-src  self, the API (*.ariasbodegon.com: api. in production, demo. uses the same build),
  #                Google Identity Services, R2 presigned PUT uploads (*.r2.cloudflarestorage.com)
  #   frame-src    Google Identity Services sign-in iframe
  #   Mercado Pago checkout is a top-level redirect (window.location.href), which CSP does not cover.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.r2.dev https://*.ariasbodegon.com; connect-src 'self' https://*.ariasbodegon.com https://accounts.google.com https://*.r2.cloudflarestorage.com; frame-src https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'
