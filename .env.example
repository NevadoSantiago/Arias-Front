# Copiá este archivo a .env.local y completá los valores. No commitear valores reales.

# Dominio del backend. En dev se deja vacío: Vite proxea /api a localhost:8080.
VITE_API_URL=

# Número de WhatsApp de contacto (solo dígitos, con código de país).
VITE_WHATSAPP_NUMBER=

# Client ID de OAuth "Web application" de Google Cloud. Tiene que ser el mismo valor
# que GOOGLE_CLIENT_ID del backend. Si queda vacío, el botón de Google se oculta.
VITE_GOOGLE_CLIENT_ID=
